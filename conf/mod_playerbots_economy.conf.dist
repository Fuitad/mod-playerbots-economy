[worldserver]

# Enables the autonomous economy lifecycle for career eligible random bots.
# Default: 1
PlayerbotsEconomy.LifecycleEnabled = 1

# Percentage used when weighting legal career candidates toward class matching profession pairs.
# Default: 30
PlayerbotsEconomy.ClassMatchingProfessionChance = 30

# Number of full item stacks retained for known profession inputs in addition to immediate recipe use.
# Default: 2
PlayerbotsEconomy.ProfessionReserveStacks = 2

# Hard ceiling on one production work order, expressed in full stacks of the crafted item
# (most trade goods stack at 20). Orders are further limited to what the assigned bot can
# craft from reagents it holds or can obtain. 0 disables the ceiling and keeps only the
# reagent limit.
# Default: 1
PlayerbotsEconomy.Production.MaxBatchStacks = 1

# Enables autonomous speculative positions. All risk limits below must also be nonzero.
# Default: 0
PlayerbotsEconomy.MarketMakingEnabled = 0

# Maximum percentage of free tradeskill money exposed to one substitution group.
# Default: 0
PlayerbotsEconomy.MarketMakingPerGroupExposurePercent = 0

# Maximum percentage of free tradeskill money exposed across speculative positions.
# Default: 0
PlayerbotsEconomy.MarketMakingTotalExposurePercent = 0

# Minimum qualified price observations required before speculative entry.
# Default: 0
PlayerbotsEconomy.MarketMakingMinimumEvidence = 0

# Maximum holding horizon for a speculative position in seconds.
# Default: 0
PlayerbotsEconomy.MarketMakingHoldingHorizonSeconds = 0

# Maximum ordinary Auction House relist attempts for one position.
# Default: 0
PlayerbotsEconomy.MarketMakingMaximumRelistAttempts = 0

# Cooldown after a failed speculative position in seconds.
# Default: 0
PlayerbotsEconomy.MarketMakingCooldownSeconds = 0
